# Copy to .env and fill in the values. Names only here, never values.
# The console check fails when a name here has no card in console/services.json.

# Hosting
FLY_APP_NAME=
FLY_REGION=

# Database
DATABASE_URL=

# Object storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email
EMAIL_API_KEY=
EMAIL_FROM=

# Sign-in
SESSION_SIGNING_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ads
ADS_CLIENT_ID=

# DNS and domain
PUBLIC_DOMAIN=

# Relay and media
MEDIA_CACHE_ZONE=
MEDIA_RELAY_URL=

# Bot checks
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Backups
BACKUP_BUCKET=

# Source control and CI
GITHUB_REPOSITORY=

# Launch to-do flags. Set to 1 when the step is done; the item clears itself.
DONE_RUNNERS=
DONE_BACKUP=
DONE_BOT_CHECKS=
DONE_BRANCH_PROTECTION=
